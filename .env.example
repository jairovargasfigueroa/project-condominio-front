# URL base de tu API backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Entorno de desarrollo
NODE_ENV=development

# Si necesitas configuraciones adicionales para JWT o secretos del lado del servidor
# (estas no deben ser públicas, sin NEXT_PUBLIC_)
# JWT_SECRET=your-jwt-secret-here
# REFRESH_TOKEN_SECRET=your-refresh-token-secret-here

# URL de la base de datos (si manejas conexión desde Next.js)
# DATABASE_URL=your-database-connection-string