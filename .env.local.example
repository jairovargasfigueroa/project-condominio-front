# Environment variables for Spike Next.js Template
# Copy this file to .env.local and update the values as needed

# Application URL (used for API calls and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Database connection string
# DATABASE_URL=your_database_connection_string

# Optional: Authentication secrets
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your_nextauth_secret

# Optional: API Keys
# API_KEY=your_api_key
